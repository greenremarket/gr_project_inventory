# Python
__pycache__/
*.py[cod]
*$py.class

# Odoo
*.pyc
*.pyo
*.pyd
*.so
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual Environment
venv/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*.un~
*~

# Logs
*.log

# Environment variables
.env
.env.local
.env.*.local

# Database
*.db
*.sqlite3

# Local Odoo reproduction environment
.venv_odoo/
odoo/
enterprise/
odoo_data/
repro_dump/

# Third-party module clones (clone on demand, do not commit)
third_party_modules/*
!third_party_modules/.gitkeep

# EBICS keys and certificates (sensitive, never commit)
ebics_keys/*
!ebics_keys/.gitkeep

# Local repro backups
repro_backup_*.dump
repro_filestore_backup_*.zip
greenremarket_repro_*.dump
greenremarket_repro_*.zip
*.dump
*.zip

# One-off artifacts
*.exe
*.sql
investigate_db.py

# Session planning docs (local reference only)
CONTAINERIZATION_PLAN.md
LOCAL_REPRODUCTION_REPORT.md
PROD_HANDOFF_PLAN.md
DIAGNOSTIC.md

# Track dump directories, ignore their contents
dumps/instant_rollback/*
!dumps/instant_rollback/.gitkeep
dumps/rotation/*
!dumps/rotation/.gitkeep
