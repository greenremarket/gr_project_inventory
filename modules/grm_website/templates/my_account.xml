<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <odoo>
    <template id="portal_my_home_custom" name="Home portal">
      <t t-call="website.layout">
        <div class="container my_account pt16">
          <t t-set="is_task_portal" t-value="request.env.user.partner_id.task_portal_ok"/>
          <div class="row g-3 mb16">
            <div class="col-md-4 position-relative">
              <img src="/grm_website/static/src/img/green_separator.svg" alt="Dashboard Image" class="separate_green"/>
              <img src="/grm_website/static/src/img/account_1.png" alt="Dashboard Image"
                   class="img-fluid card-custom img-accountTop p-0 mb16"/>
              <div class="card card-custom bg-dark-custom mb-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <h4>
                      <img src="/grm_website/static/src/img/ico_account.svg" class="mb8 ico-acount"/>
                      <br/>Your orders
                    </h4>
                  </div>
                  <div>
                    <a href="/my/orders" class="btn btn-primary">View</a>
                  </div>
                </div>
                <p class="lead mb0">Track, view or pay your orders</p>
              </div>
              <div t-if="is_task_portal" class="card card-custom hide-mobile">
                <div class="d-flex justify-content-between align-items-center mob-100">
                  <div>
                    <h4>
                      <img src="/grm_website/static/src/img/ico_account.svg" class="mb8 ico-acount"/>
                      <br/>Your invoices
                    </h4>
                    <p class="lead mb32">Track, download or pay your invoices</p>
                  </div>
                  <div>
                    <a href="/my/invoices" class="btn btn-primary">View</a>
                  </div>
                </div>
                <t t-if="invoices">
                  <t t-foreach="invoices" t-as="invoice">
                    <div class="d-flex justify-content-between align-items-start">
                      <div class="d-flex justify-content-between w-100">
                        <div class="me-2 d-flex">
                          <span class="ico-green"/>
                          <div class="ms-3 me-2">
                            <a class="text-dark" t-att-href="invoice.get_portal_url()" t-att-title="invoice.name">
                              <h5>
                                <t t-esc="invoice.name"/>
                              </h5>
                              <p class="lead text-grey">
                                <t t-esc="invoice.invoice_origin or invoice.name"/>
                              </p>
                            </a>
                          </div>
                        </div>
                        <div class="ms-2">
                          <t t-if="invoice.state == 'posted'" name="invoice_status_posted">
                            <span t-if="invoice.payment_state in ('paid', 'in_payment')"
                                  class="status-pill paid">
                              <span class="d-none d-md-inline">Paid</span>
                            </span>
                            <span t-elif="invoice.payment_state == 'reversed'"
                                  class="status-pill done">
                              <span class="d-none d-md-inline">Reversed</span>
                            </span>
                            <span t-else="" class="status-pill in-progress"
                                  name="invoice_status_waiting_for_payment">
                              <span class="d-none d-md-inline">Waiting for Payment</span>
                            </span>
                          </t>
                          <t t-elif="invoice.state == 'cancel'">
                            <span class="status-pill late">
                              <span class="d-none d-md-inline">Cancelled</span>
                            </span>
                          </t>
                          <t t-else="">
                            <span t-attf-class="status-pill in-progress">
                              Waiting
                            </span>
                          </t>
                        </div>
                      </div>
                    </div>
                  </t>
                </t>
                <t t-else="">
                  <p class="empty_text">You have no invoices at the moment</p>
                </t>
              </div>
            </div>
            <div class="col-md-8 position-relative o_not_editable">
              <img src="/grm_website/static/src/img/arrow-circle.svg" alt=""
                   class="arrow-green separate_green hide-mobile"/>
              <div t-if="not (quotes_count == 0 and sign_request_count == 0)"
                   class="card card-custom mb16 justify-content-center img-accountTop">
                <div t-if="not quotes_count == 0" class="o_portal_index_card col-12 order-0">
                  <a href="/my/quotes" title="Quotations to review"
                     class="d-flex justify-content-start gap-2 gap-md-3 align-items-center py-3 pe-2 px-md-3 rounded text-decoration-none text-reset alert alert-primary">
                    <div>
                      <h5 class="mt-0 d-flex gap-2">
                        <span t-esc="quotes_count">0</span>
                        <span>Quotations to review</span>
                      </h5>
                    </div>
                  </a>
                </div>
                <div t-if="not sign_request_count == 0" class="o_portal_index_card col-12 order-0">
                  <a href="/my/signatures" title="Document(s) to sign"
                     class="d-flex justify-content-start gap-2 gap-md-3 align-items-center py-3 pe-2 px-md-3 rounded text-decoration-none text-reset alert alert-primary">
                    <div>
                      <h5 class="mt-0 d-flex gap-2">
                        <span t-esc="sign_request_count">0</span>
                        <span>Document(s) to sign</span>
                      </h5>
                    </div>
                  </a>
                </div>
              </div>
              <div class="row">
                <div class="col-md-7">
                  <div t-if="not is_task_portal" class="card card-custom hide-mobile">
                    <div class="d-flex justify-content-between align-items-center mob-100">
                      <div>
                        <h4>
                          <img src="/grm_website/static/src/img/ico_account.svg" class="mb8 ico-acount"/>
                          <br/>Your invoices
                        </h4>
                        <p class="lead mb32">Track, download or pay your invoices</p>
                      </div>
                      <div>
                        <a href="/my/invoices" class="btn btn-primary">View</a>
                      </div>
                    </div>
                    <t t-if="invoices">
                      <t t-foreach="invoices" t-as="invoice">
                        <div class="d-flex justify-content-between align-items-start">
                          <div class="d-flex justify-content-between w-100">
                            <div class="me-2 d-flex">
                              <span class="ico-green"/>
                              <div class="ms-3 me-2">
                                <a class="text-dark" t-att-href="invoice.get_portal_url()" t-att-title="invoice.name">
                                  <h5>
                                    <t t-esc="invoice.name"/>
                                  </h5>
                                  <p class="lead text-grey">
                                    <t t-esc="invoice.invoice_origin or invoice.name"/>
                                  </p>
                                </a>
                              </div>
                            </div>
                            <div class="ms-2">
                              <t t-if="invoice.state == 'posted'" name="invoice_status_posted">
                                <span t-if="invoice.payment_state in ('paid', 'in_payment')"
                                      class="status-pill paid">
                                  <span class="d-none d-md-inline">Paid</span>
                                </span>
                                <span t-elif="invoice.payment_state == 'reversed'"
                                      class="status-pill done">
                                  <span class="d-none d-md-inline">Reversed</span>
                                </span>
                                <span t-else="" class="status-pill in-progress"
                                      name="invoice_status_waiting_for_payment">
                                  <span class="d-none d-md-inline">Waiting for Payment</span>
                                </span>
                              </t>
                              <t t-elif="invoice.state == 'cancel'">
                                <span class="status-pill late">
                                  <span class="d-none d-md-inline">Cancelled</span>
                                </span>
                              </t>
                              <t t-else="">
                                <span t-attf-class="status-pill in-progress">
                                  Waiting
                                </span>
                              </t>
                            </div>
                          </div>
                        </div>
                      </t>
                    </t>
                    <t t-else="">
                      <p class="empty_text">You have no invoices at the moment</p>
                    </t>
                  </div>
                  <div t-else="" class="card card-custom">
                    <div class="d-flex justify-content-between align-items-center">
                      <div>
                        <h4>
                          <img src="/grm_website/static/src/img/ico_account.svg" class="mb8 ico-acount"/>
                          <br/>Your Operations
                        </h4>
                        <p class="lead mb0">Track the progress of your Operations</p>
                      </div>
                      <div>
                        <a href="/my/tasks" class="btn btn-primary">View</a>
                      </div>
                    </div>
                    <t t-if="tasks">
                      <ul class="list-unstyled mb-0">
                        <t t-foreach="tasks" t-as="task">
                          <li t-if="'PD3E' in task.tag_ids.mapped('name')" class="mt-3 d-flex justify-content-between align-items-start">
                            <a class="d-flex text-dark" t-att-href="task.get_portal_url()" t-att-title="task.name">
                              <span
                                      t-att-title="dict(task.fields_get(allfields=['state'])['state']['selection'])[task.state]"
                                      t-attf-class="check-task #{'fa' if task.state in ['1_done','1_canceled','04_waiting_normal'] else '' } #{'fa-check bg-secondary text-white checked-task' if task.state == '1_done' else 'fa-times text-danger' if task.state == '1_canceled' else 'bg-warning' if task.state == '02_changes_requested' else 'bg-success' if task.state == '03_approved' else 'fa-hourglass-o' if task.state == '04_waiting_normal' else ''}"
                              />
                              <div t-attf-class="#{'checked-task' if task.state == '1_done' else '' }">
                                <h5>
                                  <t t-esc="task.name"/>
                                </h5>
                                <p class="lead mb0">
                                  <t t-esc="task.project_id.name"/>
                                </p>
                              </div>
                            </a>
                            <div>
                              <span t-attf-class="status-pill o_status #{'paid' if task.state == '1_done' else 'late' if task.state == '1_canceled' else 'bg-warning' if task.state == '02_changes_requested' else 'done' if task.state == '03_approved' else 'in-progress'}">
                                <t t-esc="dict(task.fields_get(allfields=['state'])['state']['selection'])[task.state]"/>
                              </span>
                            </div>
                          </li>
                        </t>
                      </ul>
                    </t>
                    <t t-else="">
                      <p class="empty_text">You have no operations at the moment</p>
                    </t>
                  </div>
                  <div class="card mb-3 mt32 card-custom hide-desktop">
                    <div class="d-flex justify-content-between align-items-center mob-100">
                      <div>
                        <h4>
                          <img src="/grm_website/static/src/img/ico_account.svg" class="mb8 ico-acount"/>
                          <br/>Your invoices
                        </h4>
                        <p class="lead mb32">Track, download or pay your invoices</p>
                      </div>
                      <div>
                        <a href="/my/invoices" class="btn btn-primary">View</a>
                      </div>
                    </div>
                    <t t-if="invoices">
                      <t t-foreach="invoices" t-as="invoice">
                        <div class="d-flex justify-content-between align-items-start">
                          <div class="d-flex justify-content-between w-100">
                            <div class="me-2 d-flex">
                              <span class="ico-green"/>
                              <div class="ms-3 me-2">
                                <a class="text-dark" t-att-href="invoice.get_portal_url()" t-att-title="invoice.name">
                                  <h5>
                                    <t t-esc="invoice.name"/>
                                  </h5>
                                  <p class="lead text-grey">
                                    <t t-esc="invoice.invoice_origin or invoice.name"/>
                                  </p>
                                </a>
                              </div>
                            </div>
                            <div class="ms-2">
                              <t t-if="invoice.state == 'posted'" name="invoice_status_posted">
                                <span t-if="invoice.payment_state in ('paid', 'in_payment')"
                                      class="status-pill paid">
                                  <span class="d-none d-md-inline">Paid</span>
                                </span>
                                <span t-elif="invoice.payment_state == 'reversed'"
                                      class="status-pill done">
                                  <span class="d-none d-md-inline">Reversed</span>
                                </span>
                                <span t-else="" class="status-pill in-progress"
                                      name="invoice_status_waiting_for_payment">
                                  <span class="d-none d-md-inline">Waiting for Payment</span>
                                </span>
                              </t>
                              <t t-elif="invoice.state == 'cancel'">
                                <span class="status-pill late">
                                  <span class="d-none d-md-inline">Cancelled</span>
                                </span>
                              </t>
                              <t t-else="">
                                <span t-attf-class="status-pill in-progress">
                                  Waiting
                                </span>
                              </t>
                            </div>
                          </div>
                        </div>
                      </t>
                    </t>
                    <t t-else="">
                      <p class="empty_text">You have no tasks at the moment</p>
                    </t>
                  </div>
                </div>
                <div class="col-md-5 ps-0 space-mobile">
                  <div class="card card-custom bg-dark-custom px-4 mb16">
                    <div class="d-flex justify-content-between align-items-center">
                      <div>
                        <h4 class="mb-0">
                          <img src="/grm_website/static/src/img/ico_account2.svg" class="mb8 ico-acount"/>
                          <br/>
                          Login &amp;<br/>Security
                        </h4>
                      </div>
                      <div>
                        <a href="/my/security" class="btn btn-primary">View</a>
                      </div>
                    </div>
                  </div>
                  <div class="card card-custom bg-primary text-white px-5 py-5">
                    <h1 class="mb-4 mt-3 name_user">
                      <t t-esc="user.name"/>
                    </h1>
                    <div t-if="user.street" class="d-flex">
                      <i class="fa fa-map-marker me-2"></i>
                      <p class="lead">
                        <t t-esc="user.street or ''"/>
                        <br/>
                        <t t-esc="user.zip or ''"/>
                        <t t-esc="user.city or ''"/>
                        <br/>
                        <t t-esc="user.country_id.name or ''"/>
                      </p>
                    </div>
                    <div t-if="user.phone" class="d-flex">
                      <i class="fa fa-phone me-2"></i>
                      <p class="lead">
                        <t t-esc="user.phone or ''"/>
                      </p>
                    </div>
                    <div t-if="user.email" class="d-flex">
                      <i class="fa fa-envelope me-2"></i>
                      <p class="lead">
                        <t t-esc="user.email"/>
                      </p>
                    </div>
                    <a href="/my/account" class="btn btn-dark mt8 mb8">Edit Information</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </t>
    </template>
  </odoo>

</odoo>
