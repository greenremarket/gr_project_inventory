<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- NOTE: planned_date_begin is intentionally kept invisible in the form view.
         The enterprise daterange widget on date_deadline already exposes it as the
         start-of-range field. Making it visible as a standalone field inside
         div#date_deadline_and_recurring_task (d-inline-flex) causes layout corruption. -->

    <!-- List view: enterprise adds planned_date_begin with column_invisible="True" to
         project_task_view_tree_base (the parent of view_task_tree2).
         We inherit view_task_tree2 and make that existing field show as an optional column. -->
    <record id="view_task_tree_planned_date_field" model="ir.ui.view">
        <field name="name">project.task.tree.planned.date.field</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='planned_date_begin']" position="attributes">
                <attribute name="column_invisible">0</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
