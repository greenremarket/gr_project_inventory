<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="website.contactus" model="ir.ui.view">
    <field name="active">False</field>
  </record>

  <record id="contact_us_template" model="website.page">
    <field name="url">/contactus</field>
    <field name="is_published">True</field>
    <field name="website_indexed" eval="True"/>
    <field name="name">Contact Us</field>
    <field name="type">qweb</field>
    <field name="key">grm_website.contact_us_template</field>
    <field name="arch" type="xml">
      <t t-call="website.layout">
        <div id="wrap" class="oe_structure oe_empty">
          <section class="custom_grid o_colored_level pt16">
            <div class="container">
              <div class="row s_nb_column_fixed align-items-center">
                <div class="hide-mobile o_colored_level col-lg-5">
                  <section class="custom_grid s_masonry_block o_colored_level" data-vcss="001">
                    <div class="container">
                      <div class="row o_grid_mode" data-row-count="11">
                        <div class="o_grid_item o_grid_item_image text-center o_colored_level g-height-4 g-col-lg-5 col-lg-5"
                             style="z-index: 1;background-image: none;grid-area: 1 / 1 / 6 / 13;">
                          <img src="/grm_website/static/src/img/contact-1.png" alt=""
                               class="img img-fluid mx-auto o_we_custom_image rounded"/>
                        </div>
                        <div class="pad-girdCustom2 o_grid_item o_grid_item_image text-center o_colored_level g-height-4 g-col-lg-5 col-lg-5"
                             style="z-index: 1;background-image: none;grid-area: 5 / 2 / 13 / 12;padding: 15px !important;background-color: #fff;border-radius: 75px;">
                          <img src="/grm_website/static/src/img/contact-2.png" alt=""
                               class="img img-fluid mx-auto o_we_custom_image rounded"/>
                        </div>
                        <div class="o_grid_item o_grid_item_image text-center o_colored_level g-height-2 g-col-lg-2 col-lg-2"
                             style="z-index: 3;grid-area: 4 / 10 / 6 / 15;background-image: none;position: relative;top: 31px;">
                          <img src="/grm_website/static/src/img/separator-green.svg" alt=""
                               class="object-fit-contain img img-fluid o_we_custom_image"/>
                        </div>
                      </div>
                    </div>
                  </section>
                </div>
                <div class="col-lg-7 o_colored_level">
                  <section class="s_website_form">
                    <h1>Contact Us</h1>
                    <p>
                      Contact us for anything related to our company or services.
                      <br/>
                      We will do our best to respond to you as soon as possible.
                      <br/>
                      You can call us at :
                      <p>
                        <a href="tel:+33183902626">0183902626</a>
                        |
                        <a href="skype:+183902626?call" target="_blank">Skype</a>
                        |
                        <a href="msteams://tel:+183902626" target="_blank">Teams</a>
                        |
                        <a href="https://wa.me/183902626" target="_blank">WhatsApp</a>
                      </p>
                    </p>
                    <form
                            id="contactus_form"
                            action="/website/form/"
                            method="post"
                            enctype="multipart/form-data"
                            class="o_mark_required pt32"
                            data-mark="*"
                            data-model_name="mail.mail"
                            data-success-mode="redirect"
                            data-success-page="/contactus-thank-you"
                            data-pre-fill="true"
                    >
                      <div class="s_website_form_rows row s_col_no_bgcolor">
                        <div
                                class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required"
                                data-type="char"
                                data-name="Field"
                        >
                          <label class="s_website_form_label d-none" for="contact1">
                            <span class="s_website_form_label_content">Full name</span>
                            <span class="s_website_form_mark">*</span>
                          </label>
                          <input
                                  id="contact1"
                                  type="text"
                                  class="form-control s_website_form_input"
                                  name="name"
                                  required=""
                                  data-fill-with="name"
                                  placeholder="Full name*"
                          />
                        </div>
                        <div
                                class="mb-3 col-lg-6 s_website_form_field s_website_form_custom"
                                data-type="char"
                                data-name="Field"
                        >
                          <label class="s_website_form_label d-none" for="contact2">
                            <span class="s_website_form_label_content">Phone number</span>
                          </label>
                          <input
                                  id="contact2"
                                  type="tel"
                                  class="form-control s_website_form_input"
                                  name="phone"
                                  required="required"
                                  data-fill-with="phone"
                                  placeholder="Phone number*"
                          />
                        </div>
                        <div
                                class="mb-3 col-lg-6 s_website_form_field s_website_form_required s_website_form_model_required"
                                data-type="email"
                                data-name="Field"
                        >
                          <label class="s_website_form_label d-none" for="contact3">
                            <span class="s_website_form_label_content">Email address</span>
                            <span class="s_website_form_mark">*</span>
                          </label>
                          <input
                                  id="contact3"
                                  type="email"
                                  class="form-control s_website_form_input"
                                  name="email_from"
                                  required="required"
                                  data-fill-with="email"
                                  placeholder="Email address*"
                          />
                        </div>
                        <div
                                class="mb-3 col-lg-6 s_website_form_field s_website_form_custom"
                                data-type="char"
                                data-name="Field"
                        >
                          <label class="s_website_form_label d-none" for="contact4">
                            <span class="s_website_form_label_content">Company</span>
                          </label>
                          <input
                                  id="contact4"
                                  type="text"
                                  class="form-control s_website_form_input"
                                  name="company"
                                  data-fill-with="commercial_company_name"
                                  placeholder="Company"
                          />
                        </div>
                        <div
                                class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required"
                                data-type="char"
                                data-name="Field"
                        >
                          <label class="s_website_form_label d-none" for="contact5">
                            <span class="s_website_form_label_content">Subject</span>
                            <span class="s_website_form_mark">*</span>
                          </label>
                          <input
                                  id="contact5"
                                  type="text"
                                  class="form-control s_website_form_input"
                                  name="subject"
                                  required=""
                                  placeholder="Subject*"
                          />
                        </div>
                        <div
                                class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                data-type="text"
                                data-name="Field"
                        >
                          <label class="s_website_form_label d-none" for="contact6">
                            <span class="s_website_form_label_content">Message</span>
                            <span class="s_website_form_mark">*</span>
                          </label>
                          <textarea
                                  id="contact6"
                                  class="form-control s_website_form_input pt24 pb24"
                                  name="description"
                                  required=""
                                  rows="1"
                                  placeholder="Message*"
                          />
                        </div>
                        <div class="d-none mb-3 col-12 s_website_form_field s_website_form_dnone">
                          <div class="row s_col_no_resize s_col_no_bgcolor">
                            <label class="col-form-label col-sm-auto s_website_form_label" for="contact7">
                              <span class="s_website_form_label_content">Email To</span>
                            </label>
                            <div class="col-sm">
                              <input
                                      id="contact7"
                                      type="hidden"
                                      class="form-control s_website_form_input"
                                      name="email_to"
                              />
                            </div>
                          </div>
                        </div>
                        <div
                                class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end pb0"
                                data-name="Submit Button"
                        >
                          <div class="s_website_form_label"/>
                          <a href="#" role="button" class="btn btn-primary s_website_form_send mb0 w-100">Submit</a>
                          <span id="s_website_form_result"/>
                        </div>
                      </div>
                    </form>
                  </section>
                </div>
                <div class="hide-desktop o_colored_level col-lg-5">
                  <section class="custom_grid s_masonry_block o_colored_level" data-vcss="001">
                    <div class="container">
                      <div class="row o_grid_mode" data-row-count="11">
                        <div class="o_grid_item text-center o_colored_level g-height-4 g-col-lg-5 col-lg-5"
                             style="z-index: 1;background-image: none;grid-area: 1 / 1 / 6 / 13;">
                          <img src="/grm_website/static/src/img/contact-1.png" alt=""
                               class="img img-fluid mx-auto o_we_custom_image rounded"/>
                        </div>
                        <div class="pad-girdCustom2 o_grid_item text-center o_colored_level g-height-4 g-col-lg-5 col-lg-5"
                             style="z-index: 1;background-image: none;grid-area: 5 / 2 / 13 / 12;padding: 15px !important;background-color: #fff;border-radius: 75px;">
                          <img src="/grm_website/static/src/img/contact-2.png" alt=""
                               class="img img-fluid mx-auto o_we_custom_image rounded"/>
                        </div>
                      </div>
                    </div>
                  </section>
                </div>
              </div>
            </div>
          </section>
        </div>
      </t>
    </field>
  </record>
</odoo>
