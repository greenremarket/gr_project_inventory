<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <template id="signup_form" name="Custom Signup Form">
    <t t-call="website.layout">
      <section class="custom_grid login-section s_masonry_block o_colored_level signup_grm" data-vcss="001">
        <div class="container">
          <div class="row o_grid_mode" data-row-count="11">
            <div class="o_grid_item o_colored_level g-col-lg-5 g-height-11 col-lg-5"
                 style="z-index: 2; grid-area: 1 / 1 / 13 / 9;">
              <section class="pt32">
                <h1>Access Request</h1>
                <form action="/greenremarket/signup/submit" method="POST" class="mt16">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  <div class="s_website_form_rows row s_col_no_bgcolor">
                    <div class="mb-3 col-lg-12 s_website_form_field s_website_form_custom s_website_form_required">
                      <input type="text" name="name" required="1" class="form-control s_website_form_input"
                             placeholder="Full name"/>
                    </div>

                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required">
                      <input type="email" name="email" required="1" class="form-control s_website_form_input"
                             placeholder="Email"/>
                    </div>

                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required">
                      <input type="tel" name="phone" required="1" class="form-control s_website_form_input"
                             placeholder="Phone"/>
                    </div>

                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required">
                      <input type="text" name="function" class="form-control s_website_form_input"
                             placeholder="Function"/>
                    </div>

                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required">
                      <input type="text" name="company_name" class="form-control s_website_form_input"
                             placeholder="Company"/>
                    </div>

                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required">
                      <input type="text" name="street" class="form-control s_website_form_input" placeholder="Address"/>
                    </div>

                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required">
                      <input type="text" name="zip" class="form-control s_website_form_input"
                             placeholder="Postal code"/>
                    </div>

                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required">
                      <input type="text" name="city" class="form-control s_website_form_input" placeholder="City"/>
                    </div>

                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required">
                      <select name="country_id" class="form-control s_website_form_input">
                        <option value="">Country</option>
                        <t t-foreach="request.env['res.country'].sudo().search([])" t-as="country">
                          <option t-att-value="country.id">
                            <t t-esc="country.name"/>
                          </option>
                        </t>
                      </select>
                    </div>
                  </div>
                  <div class="clearfix oe_login_buttons text-center gap-1 d-grid mb-1 pt-3">
                    <button type="submit" class="btn btn-primary mt16 s_website_form_send">Submit Request</button>
                    <div class="d-flex justify-content-between align-items-center small mt-2">
                      <a href="/web/login?redirect=%2Fmy%2Fhome%2F%3F">Back to Login Page</a>
                    </div>
                  </div>
                </form>
              </section>
            </div>
            <div class="pad-gird o_grid_item o_grid_item_image text-center o_colored_level g-height-5 g-col-lg-3 col-lg-3"
                 style="z-index: 1;background-image: none;grid-area: 2 / 10 / 7 / 15;">
              <img src="/grm_website/static/src/img/login-1.png" alt=""
                   class="img img-fluid mx-auto rounded o_we_custom_image rounded"/>
            </div>
            <div class="hide-mobile pad-gird pad-x rounded-custom bg-white o_grid_item o_grid_item_image text-center o_colored_level g-height-5 g-col-lg-3 col-lg-3"
                 style="z-index: 1;background-image: none;grid-area: 5 / 13 / 12 / 17;">
              <img src="/grm_website/static/src/img/login-2.png" alt=""
                   class="img img-fluid mx-auto o_we_custom_image rounded"/>
            </div>
            <div class="hide-mobile pad-girdCustom o_grid_item o_grid_item_image text-center o_colored_level g-height-4 g-col-lg-5 col-lg-5"
                 style="z-index: 1;background-image: none;grid-area: 7 / 9 / 13 / 13;">
              <img src="/grm_website/static/src/img/login-3.png" alt=""
                   class="img img-fluid mx-auto o_we_custom_image rounded"/>
            </div>
            <div class="hide-mobile o_grid_item o_grid_item_image text-center o_colored_level g-height-2 g-col-lg-2 col-lg-2"
                 style="z-index: 3;grid-area: 1 / 9 / 3 / 11;background-image: none;position: relative;top: 80px;">
              <img src="/grm_website/static/src/img/separator-green.svg" alt=""
                   class="object-fit-contain img img-fluid o_we_custom_image"/>
            </div>
            <div class="hide-mobile o_grid_item o_grid_item_image text-center o_colored_level g-height-2 g-col-lg-1 col-lg-1"
                 style="background-image: none; z-index: 3; grid-area: 12 / 12 / 10 / 14;position: relative;top: 25px;left: 20px;">
              <img src="/grm_website/static/src/img/arrow-circle.svg" alt=""
                   class="arrow-green img img-fluid mx-auto o_we_custom_image object-fit-contain"/>
            </div>
          </div>
        </div>
      </section>
    </t>
  </template>

  <template id="signup_thank_you" name="Signup Thank You">
    <t t-call="website.layout">
      <section class="custom_grid login-section s_masonry_block o_colored_level" data-vcss="001">
        <div class="container">
          <div class="row o_grid_mode" data-row-count="11">
            <div class="o_grid_item o_colored_level g-col-lg-5 g-height-11 col-lg-5"
                 style="z-index: 2; grid-area: 1 / 1 / 13 / 9;">
              <h1>Thank you for your request.</h1>
              <p>An administrator will contact you once your request has been processed.</p>
            </div>
            <div class="pad-gird o_grid_item o_grid_item_image text-center o_colored_level g-height-5 g-col-lg-3 col-lg-3"
                 style="z-index: 1;background-image: none;grid-area: 2 / 10 / 7 / 15;">
              <img src="/grm_website/static/src/img/login-1.png" alt=""
                   class="img img-fluid mx-auto rounded o_we_custom_image rounded"/>
            </div>
            <div class="hide-mobile pad-gird pad-x rounded-custom bg-white o_grid_item o_grid_item_image text-center o_colored_level g-height-5 g-col-lg-3 col-lg-3"
                 style="z-index: 1;background-image: none;grid-area: 5 / 13 / 12 / 17;">
              <img src="/grm_website/static/src/img/login-2.png" alt=""
                   class="img img-fluid mx-auto o_we_custom_image rounded"/>
            </div>
            <div class="hide-mobile pad-girdCustom o_grid_item o_grid_item_image text-center o_colored_level g-height-4 g-col-lg-5 col-lg-5"
                 style="z-index: 1;background-image: none;grid-area: 7 / 9 / 13 / 13;">
              <img src="/grm_website/static/src/img/login-3.png" alt=""
                   class="img img-fluid mx-auto o_we_custom_image rounded"/>
            </div>
            <div class="hide-mobile o_grid_item o_grid_item_image text-center o_colored_level g-height-2 g-col-lg-2 col-lg-2"
                 style="z-index: 3;grid-area: 1 / 9 / 3 / 11;background-image: none;position: relative;top: 80px;">
              <img src="/grm_website/static/src/img/separator-green.svg" alt=""
                   class="object-fit-contain img img-fluid o_we_custom_image"/>
            </div>
            <div class="hide-mobile o_grid_item o_grid_item_image text-center o_colored_level g-height-2 g-col-lg-1 col-lg-1"
                 style="background-image: none; z-index: 3; grid-area: 12 / 12 / 10 / 14;position: relative;top: 25px;left: 20px;">
              <img src="/grm_website/static/src/img/arrow-circle.svg" alt=""
                   class="arrow-green img img-fluid mx-auto o_we_custom_image object-fit-contain"/>
            </div>
          </div>
        </div>
      </section>
    </t>
  </template>

  <template id="template_auth_signup_login" inherit_id="auth_signup.login" priority="99">
    <xpath expr="//a[@t-if='signup_enabled']" position="after">
      <a href="/greenremarket/signup">Don't have an account?</a>
    </xpath>
  </template>
</odoo>
